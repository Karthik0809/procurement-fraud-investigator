# Copy to .env and fill in. NEVER commit .env.

# NVIDIA NIM (OpenAI-compatible endpoint). Leave the key empty to run in offline mock-LLM mode.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# SAMPLE_MODE=true runs fully offline on bundled sample data (fallback if external services are down)
SAMPLE_MODE=true

# Data backend: "local" (CSV files in backend/data/sample) or "zetaris" (needs SAMPLE_MODE=false)
DATA_BACKEND=local
DATA_DIR=data/sample

# Zetaris connection (fill in from the Zetaris resources on HackOS)
ZETARIS_URL=
ZETARIS_USER=
ZETARIS_PASSWORD=
